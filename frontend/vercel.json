{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sharehouse-yv9s.onrender.com/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://sharehouse-yv9s.onrender.com/socket.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
